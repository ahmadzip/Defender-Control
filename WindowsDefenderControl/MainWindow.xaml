<Window
    x:Class="WindowsDefenderControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ShieldBorder"
                Grid.Column="0"
                Width="42"
                Height="42"
                CornerRadius="8"
                VerticalAlignment="Center">

                <FontIcon
                    x:Name="ShieldIcon"
                    Glyph="&#xE83D;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Spacing="2">

                <TextBlock
                    Text="Real-time protection"
                    FontSize="16"
                    FontWeight="SemiBold"/>

                <TextBlock
                    x:Name="ProtectionStatus"
                    Text="Status: Disabled"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Opacity="0.6"/>

            </StackPanel>

            <Grid Grid.Column="2" Width="72" Height="36" HorizontalAlignment="Right">
                <ProgressRing
                    x:Name="LoadingIndicator"
                    Width="24"
                    Height="24"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <Button
                    x:Name="ProtectionSwitch"
                    Width="72"
                    Height="36"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Click="ProtectionSwitch_Click">
                <Grid x:Name="SwitchRoot" Width="72" Height="36" Background="Transparent">
                    <Border x:Name="SwitchTrack" Width="72" Height="36" CornerRadius="18" Background="#404040"/>
                    <Border x:Name="SwitchKnob" Width="28" Height="28" CornerRadius="14" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SwitchKnobTransform" X="0"/>
                        </Border.RenderTransform>
                    </Border>
                            </Grid>
                        </Button>
                    </Grid>

                </Grid>

        <Rectangle
            Grid.Row="6"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <StackPanel
            Grid.Row="8"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">

            <Button
                Content="Windows Security"
                Padding="10,4"
                Click="OpenSecurity_Click"/>

            <Button
                Content="Manage settings"
                Padding="10,4"
                Click="OpenSettings_Click"/>

            <ComboBox x:Name="ProtectionMethod" Width="140" SelectedIndex="0" SelectionChanged="ProtectionMethod_SelectionChanged">
                <ComboBoxItem Content="PowerShell"/>
                <ComboBoxItem Content="Group Policy"/>
            </ComboBox>

        </StackPanel>

    </Grid>

</Window>